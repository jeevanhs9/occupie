# Vercel Environment Variables Template
# Copy these to your Vercel project settings under Environment Variables

# ======================
# BACKEND VARIABLES
# ======================

# Flask Configuration
FLASK_ENV=production
APP_ENV=production
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# Database (Use Vercel Postgres or external PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# CORS (Set to your Vercel frontend URL)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Session Configuration
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_HTTPONLY=True

# Rate Limiting (Optional - use Vercel KV or Upstash Redis)
# REDIS_URL=redis://your-redis-instance

# Restaurant Configuration (Optional - defaults provided)
DEFAULT_RESTAURANT_NAME=Your Restaurant Name
DEFAULT_TURN_TIME_MINUTES=75
DEFAULT_RESERVATION_WINDOW_MINUTES=90

# ======================
# FRONTEND VARIABLES
# ======================

# API Configuration (Vercel automatically proxies /api to backend)
VITE_API_BASE_URL=/api/v1
VITE_AUTH_API_URL=/api/auth
VITE_DATA_MODE=api

# IMPORTANT: Do NOT set VITE_API_PROXY_TARGET in production
# Vercel handles the API routing automatically
